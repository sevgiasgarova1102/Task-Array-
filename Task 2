#include <iostream>
using namespace std;

int minPositive(int a[], int n){
    int min = 1000000; // çox böyük bir ədəd
    for(int i = 0; i < n; i++){
        if(a[i] > 0 && a[i] < min)  // əgər müsbətdirsə və indiyə qədər ən kiçikdirsə
            min = a[i];
    }
    return min;
}

int main(){
    int a[8] = {11, 0, -3, 2, 4, -6, 3, -2};

    int result = minPositive(a, 8);

    cout << "Massivin en kicik musbet elementi: " << result << endl;

    return 0;
}
